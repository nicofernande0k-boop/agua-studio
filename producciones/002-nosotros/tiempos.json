{
 "id": "002-nosotros",
 "titulo": "¿Cuándo dejamos de pensar en nosotros?",
 "fps": 30,
 "duracion": 152.555,
 "frames": 4577,
 "frases": [
  {
   "k": 1,
   "acto": "a1",
   "texto": "Nos dijeron que teníamos que salvarnos solos.",
   "inicio": 2.0,
   "fin": 4.171
  },
  {
   "k": 2,
   "acto": "a1",
   "texto": "Que el problema del otro no era nuestro problema.",
   "inicio": 5.121,
   "fin": 7.299
  },
  {
   "k": 3,
   "acto": "a1",
   "texto": "Que si alguien se quedaba atrás, era porque no se había esforzado lo suficiente.",
   "inicio": 8.149,
   "fin": 12.468
  },
  {
   "k": 4,
   "acto": "a1",
   "texto": "Nos enseñaron a competir.",
   "inicio": 14.718,
   "fin": 16.125
  },
  {
   "k": 5,
   "acto": "a1",
   "texto": "A desconfiar.",
   "inicio": 16.925,
   "fin": 17.689
  },
  {
   "k": 6,
   "acto": "a1",
   "texto": "A mirar al de al lado como un rival.",
   "inicio": 18.489,
   "fin": 20.352
  },
  {
   "k": 7,
   "acto": "a1",
   "texto": "Y casi sin darnos cuenta, empezamos a olvidarnos de algo.",
   "inicio": 21.402,
   "fin": 24.6
  },
  {
   "k": 8,
   "acto": "a1",
   "texto": "De nosotros.",
   "inicio": 26.75,
   "fin": 27.451
  },
  {
   "k": 9,
   "acto": "a2",
   "texto": "Nos acostumbramos a escuchar que cada uno tiene lo que merece.",
   "inicio": 30.301,
   "fin": 33.439
  },
  {
   "k": 10,
   "acto": "a2",
   "texto": "Que ayudar al otro es perder el tiempo.",
   "inicio": 34.289,
   "fin": 36.249
  },
  {
   "k": 11,
   "acto": "a2",
   "texto": "Que la solidaridad es una debilidad.",
   "inicio": 37.099,
   "fin": 38.88
  },
  {
   "k": 12,
   "acto": "a2",
   "texto": "Pero mientras nos repetían que debíamos pensar solamente en nosotros mismos, empezamos a perder aquello que nos hacía fuertes.",
   "inicio": 40.03,
   "fin": 47.34
  },
  {
   "k": 13,
   "acto": "a2",
   "texto": "La capacidad de encontrarnos.",
   "inicio": 48.39,
   "fin": 49.879
  },
  {
   "k": 14,
   "acto": "a2",
   "texto": "De organizarnos.",
   "inicio": 50.629,
   "fin": 51.462
  },
  {
   "k": 15,
   "acto": "a2",
   "texto": "De tender una mano sin preguntar qué vamos a recibir a cambio.",
   "inicio": 52.212,
   "fin": 55.449
  },
  {
   "k": 16,
   "acto": "a2",
   "texto": "Porque ninguna sociedad se construyó solamente con personas intentando llegar primero.",
   "inicio": 57.599,
   "fin": 62.211
  },
  {
   "k": 17,
   "acto": "a3",
   "texto": "Sin embargo, hay algo que todavía permanece.",
   "inicio": 64.861,
   "fin": 67.231
  },
  {
   "k": 18,
   "acto": "a3",
   "texto": "Está en el vecino que ayuda cuando una familia lo pierde todo.",
   "inicio": 68.281,
   "fin": 71.611
  },
  {
   "k": 19,
   "acto": "a3",
   "texto": "En quienes se organizan para levantar un comedor.",
   "inicio": 72.461,
   "fin": 74.943
  },
  {
   "k": 20,
   "acto": "a3",
   "texto": "En los trabajadores que acompañan a un compañero.",
   "inicio": 75.793,
   "fin": 78.434
  },
  {
   "k": 21,
   "acto": "a3",
   "texto": "En los jóvenes que deciden involucrarse para cambiar una realidad que consideran injusta.",
   "inicio": 79.284,
   "fin": 83.933
  },
  {
   "k": 22,
   "acto": "a3",
   "texto": "En cada persona que entiende que la vida del otro también importa.",
   "inicio": 84.783,
   "fin": 88.001
  },
  {
   "k": 23,
   "acto": "a3",
   "texto": "Porque la solidaridad no desapareció.",
   "inicio": 90.151,
   "fin": 92.104
  },
  {
   "k": 24,
   "acto": "a3",
   "texto": "Sigue estando ahí.",
   "inicio": 92.954,
   "fin": 93.846
  },
  {
   "k": 25,
   "acto": "a3",
   "texto": "Esperando que volvamos a encontrarnos.",
   "inicio": 94.696,
   "fin": 96.682
  },
  {
   "k": 26,
   "acto": "a4",
   "texto": "Tal vez nos hicieron creer que el futuro era una carrera individual.",
   "inicio": 99.132,
   "fin": 102.824
  },
  {
   "k": 27,
   "acto": "a4",
   "texto": "Que triunfar significaba llegar más lejos que los demás.",
   "inicio": 103.674,
   "fin": 106.605
  },
  {
   "k": 28,
   "acto": "a4",
   "texto": "Pero una patria no es una competencia.",
   "inicio": 107.655,
   "fin": 109.614
  },
  {
   "k": 29,
   "acto": "a4",
   "texto": "Una patria es una construcción colectiva.",
   "inicio": 110.564,
   "fin": 112.575
  },
  {
   "k": 30,
   "acto": "a4",
   "texto": "Y ningún pueblo puede construir un futuro verdaderamente compartido si aprende a mirar para otro lado cuando alguien necesita ayuda.",
   "inicio": 113.625,
   "fin": 120.911
  },
  {
   "k": 31,
   "acto": "a4",
   "texto": "Porque el destino del otro...",
   "inicio": 123.961,
   "fin": 125.399
  },
  {
   "k": 32,
   "acto": "a4",
   "texto": "También es el nuestro.",
   "inicio": 126.549,
   "fin": 127.676
  },
  {
   "k": 33,
   "acto": "a5",
   "texto": "Quizás la pregunta no sea cuándo dejamos de pensar en nosotros.",
   "inicio": 130.326,
   "fin": 133.816
  },
  {
   "k": 34,
   "acto": "a5",
   "texto": "Quizás la verdadera pregunta sea...",
   "inicio": 134.866,
   "fin": 136.684
  },
  {
   "k": 35,
   "acto": "a5",
   "texto": "¿Cuándo vamos a volver a hacerlo?",
   "inicio": 138.834,
   "fin": 140.552
  },
  {
   "k": 36,
   "acto": "a5",
   "texto": "Patria en disputa.",
   "inicio": 143.002,
   "fin": 143.967
  },
  {
   "k": 37,
   "acto": "a5",
   "texto": "La historia no se mira desde afuera.",
   "inicio": 145.117,
   "fin": 146.902
  },
  {
   "k": 38,
   "acto": "a5",
   "texto": "Se disputa.",
   "inicio": 147.852,
   "fin": 148.555
  }
 ],
