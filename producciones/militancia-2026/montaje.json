 ],
 "frases": [
  {
   "k": 1,
   "acto": "apertura",
   "texto": "Hay quienes dedican su vida a construir un futuro que quizás nunca lleguen a ver.",
   "inicio": 1.2,
   "fin": 5.917
  },
  {
   "k": 2,
   "acto": "apertura",
   "texto": "Que caminan bajo la lluvia.",
   "inicio": 6.557,
   "fin": 8.24
  },
  {
   "k": 3,
   "acto": "apertura",
   "texto": "Que pierden.",
   "inicio": 8.58,
   "fin": 9.42
  },
  {
   "k": 4,
   "acto": "apertura",
   "texto": "Que vuelven a empezar.",
   "inicio": 9.76,
   "fin": 11.162
  },
  {
   "k": 5,
   "acto": "apertura",
   "texto": "Que, aun cuando todo parece perdido, siguen creyendo.",
   "inicio": 11.602,
   "fin": 14.866
  },
  {
   "k": 6,
   "acto": "apertura",
   "texto": "La historia los conoce con un nombre:",
   "inicio": 15.606,
   "fin": 17.851
  },
  {
   "k": 7,
   "acto": "apertura",
   "texto": "militantes.",
   "inicio": 18.391,
   "fin": 19.175
  },
  {
   "k": 8,
   "acto": "proscripcion",
   "texto": "Durante diecisiete años intentaron borrar al peronismo de la Argentina.",
   "inicio": 20.215,
   "fin": 24.37
  },
  {
   "k": 9,
   "acto": "proscripcion",
   "texto": "Prohibieron sus símbolos.",
   "inicio": 24.81,
   "fin": 26.381
  },
  {
   "k": 10,
   "acto": "proscripcion",
   "texto": "Persiguieron a sus dirigentes.",
   "inicio": 26.621,
   "fin": 28.472
  },
  {
   "k": 11,
   "acto": "proscripcion",
   "texto": "Encarcelaron a sus compañeros.",
   "inicio": 28.712,
   "fin": 30.564
  },
  {
   "k": 12,
   "acto": "proscripcion",
   "texto": "Pero hubo algo que no pudieron destruir:",
   "inicio": 31.204,
   "fin": 33.617
  },
  {
   "k": 13,
   "acto": "proscripcion",
   "texto": "la memoria de un pueblo organizado.",
   "inicio": 34.057,
   "fin": 36.19
  },
  {
   "k": 14,
   "acto": "proscripcion",
   "texto": "Lo escribieron en las paredes, año tras año:",
   "inicio": 36.73,
   "fin": 39.428
  },
  {
   "k": 15,
   "acto": "proscripcion",
   "texto": "Luche y vuelve.",
   "inicio": 39.768,
   "fin": 40.777
  },
  {
   "k": 16,
   "acto": "regreso",
   "texto": "El diecisiete de noviembre de mil novecientos setenta y dos, bajo una lluvia que quedó grabada en la historia,",
   "inicio": 41.817,
   "fin": 48.132
  },
  {
   "k": 17,
   "acto": "regreso",
   "texto": "Perón volvió a pisar suelo argentino.",
   "inicio": 48.472,
   "fin": 50.717
  },
  {
   "k": 18,
   "acto": "regreso",
   "texto": "Y detrás de ese regreso estaban miles de hombres y mujeres que nunca dejaron de luchar.",
   "inicio": 51.457,
   "fin": 56.511
  },
  {
   "k": 19,
   "acto": "regreso",
   "texto": "En las fábricas.",
   "inicio": 56.951,
   "fin": 58.016
  },
  {
   "k": 20,
   "acto": "regreso",
   "texto": "En los barrios.",
   "inicio": 58.256,
   "fin": 59.265
  },
  {
   "k": 21,
   "acto": "regreso",
   "texto": "En los sindicatos.",
   "inicio": 59.505,
   "fin": 60.682
  },
  {
   "k": 22,
   "acto": "regreso",
   "texto": "En las universidades.",
   "inicio": 60.922,
   "fin": 62.268
  },
  {
   "k": 23,
   "acto": "militar",
   "texto": "Porque militar nunca fue solamente levantar una bandera.",
   "inicio": 63.108,
   "fin": 66.421
  },
  {
   "k": 24,
   "acto": "militar",
   "texto": "Es levantarse cuando otros se resignan.",
   "inicio": 66.861,
   "fin": 69.218
  },
  {
   "k": 25,
   "acto": "militar",
   "texto": "Es organizarse cuando todo invita al individualismo.",
   "inicio": 69.558,
   "fin": 72.645
  },
  {
   "k": 26,
   "acto": "militar",
   "texto": "Es entender que el dolor del otro también nos pertenece.",
   "inicio": 72.985,
   "fin": 76.298
  },
  {
   "k": 27,
   "acto": "militar",
   "texto": "Y muchas veces, hacerlo sin que nadie conozca tu nombre.",
   "inicio": 76.638,
   "fin": 80.01
  },
  {
   "k": 28,
   "acto": "hoy",
   "texto": "Hoy, cuando nos quieren convencer de que cada uno debe salvarse solo,",
   "inicio": 80.95,
   "fin": 84.962
  },
  {
   "k": 29,
   "acto": "hoy",
   "texto": "militar sigue siendo un acto de rebeldía.",
   "inicio": 85.302,
   "fin": 87.772
  },
  {
   "k": 30,
   "acto": "hoy",
   "texto": "Frente al individualismo,",
   "inicio": 88.412,
   "fin": 89.893
  },
  {
   "k": 31,
   "acto": "hoy",
   "texto": "la comunidad.",
   "inicio": 90.133,
   "fin": 91.029
  },
  {
   "k": 32,
   "acto": "hoy",
   "texto": "Frente a la indiferencia,",
   "inicio": 91.369,
   "fin": 92.85
  },
  {
   "k": 33,
   "acto": "hoy",
   "texto": "el compromiso.",
   "inicio": 93.09,
   "fin": 94.043
  },
  {
   "k": 34,
   "acto": "hoy",
   "texto": "Frente a la resignación,",
   "inicio": 94.383,
   "fin": 95.807
  },
  {
   "k": 35,
   "acto": "hoy",
   "texto": "la esperanza.",
   "inicio": 96.047,
   "fin": 96.944
  },
  {
   "k": 36,
   "acto": "homenaje",
   "texto": "A los que estuvieron.",
   "inicio": 97.784,
   "fin": 99.13
  },
  {
   "k": 37,
   "acto": "homenaje",
   "texto": "A los que están.",
   "inicio": 99.47,
   "fin": 100.535
  },
  {
   "k": 38,
   "acto": "homenaje",
   "texto": "A los que ya no están, pero siguen presentes en cada lucha.",
   "inicio": 100.875,
   "fin": 104.415
  },
  {
