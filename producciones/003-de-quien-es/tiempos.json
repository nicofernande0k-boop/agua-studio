{
 "estimado": true,
 "id": "003-de-quien-es",
 "titulo": "¿De quién es la Argentina?",
 "fps": 30,
 "duracion": 80.945,
 "frames": 2428,
 "desfaseVoz": 0.15,
 "frases": [
  {
   "k": 1,
   "acto": "gancho",
   "texto": "Tenemos petróleo. Gas. Litio. Agua. Tierra.",
   "inicio": 0.15,
   "fin": 3.645
  },
  {
   "k": 2,
   "acto": "gancho",
   "texto": "¿Por qué uno de cada tres argentinos es pobre?",
   "inicio": 3.985,
   "fin": 7.069
  },
  {
   "k": 3,
   "acto": "riqueza",
   "texto": "Vaca Muerta bate récords.",
   "inicio": 7.809,
   "fin": 9.565
  },
  {
   "k": 4,
   "acto": "riqueza",
   "texto": "El segundo potencial de gas no convencional del mundo.",
   "inicio": 9.905,
   "fin": 13.496
  },
  {
   "k": 5,
   "acto": "riqueza",
   "texto": "Uno de los mayores recursos de litio del planeta.",
   "inicio": 13.836,
   "fin": 17.111
  },
  {
   "k": 6,
   "acto": "riqueza",
   "texto": "Casi diecisiete mil glaciares.",
   "inicio": 17.451,
   "fin": 19.523
  },
  {
   "k": 7,
   "acto": "riqueza",
   "texto": "El octavo país más extenso de la Tierra.",
   "inicio": 19.863,
   "fin": 22.568
  },
  {
   "k": 8,
   "acto": "paradoja",
   "texto": "Y aun así, casi la mitad de nuestros chicos es pobre.",
   "inicio": 23.208,
   "fin": 26.795
  },
  {
   "k": 9,
   "acto": "paradoja",
   "texto": "La pregunta no es qué tenemos.",
   "inicio": 27.535,
   "fin": 29.607
  },
  {
   "k": 10,
   "acto": "paradoja",
   "texto": "Es de quién es.",
   "inicio": 30.047,
   "fin": 31.17
  },
  {
   "k": 11,
   "acto": "disputa",
   "texto": "¿De quién son? La Constitución dice: de las provincias.",
   "inicio": 32.01,
   "fin": 35.964
  },
  {
   "k": 12,
   "acto": "disputa",
   "texto": "¿Quién los extrae? Grandes empresas. Muchas, extranjeras.",
   "inicio": 36.404,
   "fin": 40.545
  },
  {
   "k": 13,
   "acto": "disputa",
   "texto": "¿Cuánto queda? Por el litio, regalías de entre el tres y el cinco por ciento.",
   "inicio": 40.985,
   "fin": 46.242
  },
  {
   "k": 14,
   "acto": "disputa",
   "texto": "¿Quién cuida el agua? Desde 2026, cada provincia elige qué glaciares proteger.",
   "inicio": 46.682,
   "fin": 52.002
  },
  {
   "k": 15,
   "acto": "disputa",
   "texto": "¿Y las reglas? Treinta años garantizadas para los grandes inversores.",
   "inicio": 52.442,
   "fin": 57.132
  },
  {
   "k": 16,
   "acto": "disputa",
   "texto": "Empresas. Nación. Provincias. Comunidades.",
   "inicio": 57.772,
   "fin": 61.054
  },
  {
   "k": 17,
   "acto": "disputa",
   "texto": "Todos disputan lo mismo: quién decide, y quién se beneficia.",
   "inicio": 61.394,
   "fin": 65.575
  },
  {
   "k": 18,
   "acto": "cierre",
   "texto": "Porque la riqueza no está bajo el suelo.",
   "inicio": 66.515,
   "fin": 69.219
  },
  {
   "k": 19,
   "acto": "cierre",
   "texto": "Está en las decisiones.",
   "inicio": 69.659,
   "fin": 71.288
  },
  {
   "k": 20,
   "acto": "cierre",
   "texto": "Un país no es soberano por lo que tiene.",
   "inicio": 72.228,
   "fin": 74.933
  },
  {
   "k": 21,
   "acto": "cierre",
   "texto": "Es soberano por lo que decide.",
   "inicio": 75.473,
   "fin": 77.545
  }
 ],
