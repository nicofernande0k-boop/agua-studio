{
 "estimado": false,
 "id": "003-de-quien-es",
 "titulo": "¿De quién es la Argentina?",
 "fps": 30,
 "duracion": 70.94,
 "frames": 2128,
 "desfaseVoz": 0.12,
 "frases": [
  {
   "k": 1,
   "acto": "gancho",
   "texto": "Tenemos petróleo. Gas. Litio. Agua. Tierra.",
   "inicio": 0.12,
   "fin": 5.49
  },
  {
   "k": 2,
   "acto": "gancho",
   "texto": "¿Entonces por qué uno de cada tres argentinos es pobre?",
   "inicio": 6.12,
   "fin": 9.1
  },
  {
   "k": 3,
   "acto": "riqueza",
   "texto": "Vaca Muerta bate récords.",
   "inicio": 9.56,
   "fin": 11.16
  },
  {
   "k": 4,
   "acto": "riqueza",
   "texto": "El segundo potencial de gas no convencional del mundo.",
   "inicio": 11.56,
   "fin": 14.42
  },
  {
   "k": 5,
   "acto": "riqueza",
   "texto": "Uno de los mayores recursos de litio del planeta.",
   "inicio": 14.7,
   "fin": 17.22
  },
  {
   "k": 6,
   "acto": "riqueza",
   "texto": "Casi diecisiete mil glaciares.",
   "inicio": 17.52,
   "fin": 19.52
  },
  {
   "k": 7,
   "acto": "riqueza",
   "texto": "El octavo país más extenso de la Tierra.",
   "inicio": 19.74,
   "fin": 22.08
  },
  {
   "k": 8,
   "acto": "paradoja",
   "texto": "Y aun así, casi la mitad de nuestros chicos es pobre.",
   "inicio": 22.4,
   "fin": 25.7
  },
  {
   "k": 9,
   "acto": "paradoja",
   "texto": "La pregunta no es qué tenemos.",
   "inicio": 26.16,
   "fin": 27.96
  },
  {
   "k": 10,
   "acto": "paradoja",
   "texto": "Es de quién es.",
   "inicio": 28.28,
   "fin": 29.47
  },
  {
   "k": 11,
   "acto": "disputa",
   "texto": "¿De quién son? La Constitución dice: de las provincias.",
   "inicio": 29.7,
   "fin": 33.12
  },
  {
   "k": 12,
   "acto": "disputa",
   "texto": "¿Quién los extrae? Grandes empresas. Muchas, extranjeras.",
   "inicio": 33.34,
   "fin": 37.2
  },
  {
   "k": 13,
   "acto": "disputa",
   "texto": "¿Cuánto queda? Por el litio, las provincias cobran regalías de entre el tres y el cinco por ciento.",
   "inicio": 37.44,
   "fin": 42.47
  },
  {
   "k": 14,
   "acto": "disputa",
   "texto": "¿Quién cuida el agua? Desde 2026, cada provincia elige qué glaciares proteger.",
   "inicio": 42.64,
   "fin": 47.63
  },
  {
   "k": 15,
   "acto": "disputa",
   "texto": "¿Y las reglas? Treinta años garantizadas para los grandes inversores.",
   "inicio": 47.84,
   "fin": 51.62
  },
  {
   "k": 16,
   "acto": "disputa",
   "texto": "Empresas. Nación. Provincias. Comunidades.",
   "inicio": 52.16,
   "fin": 55.42
  },
  {
   "k": 17,
   "acto": "disputa",
   "texto": "Todos disputan lo mismo: quién decide, y quién se beneficia.",
   "inicio": 55.62,
   "fin": 59.45
  },
  {
   "k": 18,
   "acto": "cierre",
   "texto": "Porque la riqueza no está bajo el suelo.",
   "inicio": 59.74,
   "fin": 61.73
  },
  {
   "k": 19,
   "acto": "cierre",
   "texto": "Está en las decisiones.",
   "inicio": 62.24,
   "fin": 63.31
  },
  {
   "k": 20,
   "acto": "cierre",
   "texto": "Un país no es soberano por lo que tiene.",
   "inicio": 63.56,
   "fin": 65.54
  },
  {
   "k": 21,
   "acto": "cierre",
   "texto": "Es soberano por lo que decide.",
   "inicio": 65.88,
   "fin": 67.54
  }
 ],
